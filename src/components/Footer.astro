---
import Wave from "./Wave.astro";
import VersionNumber from "./VersionNumber.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>Logan Waters &copy; {currentYear}</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/attribution" title="View Site Attribution">Attribution</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/logandwaters/logandwaters.com" title="View Site Source">Source</a>
      <VersionNumber />
    </nav>
  </div>
  <div class="footer-waves" aria-hidden="true">
    <Wave />
    <Wave />
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(var(--site-width) * 1.25), calc(100vw - 40px));
    margin: 0 auto;
    padding: var(--space-2xl) 0 var(--space-4xl);
    border-top: 1px solid var(--border-color);
    font-size: var(--font-size-meta);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-links a {
    color: var(--body-text-color);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--body-text-color-hover);
  }

  .footer-waves {
    display: flex;
    overflow: hidden;
  }
</style>
