---
import Wave from "./Wave.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>Logan Waters &copy; {currentYear}</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="mailto:me@logandwaters.com">Email</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/logandwaters/logandwaters.com">Source</a>
      <span aria-hidden="true">·</span>
      <a href="#attribution">Attribution</a>
    </nav>
  </div>
  <div class="footer-waves" aria-hidden="true">
    <Wave />
    <Wave />
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(calc(100% - 40px), var(--max-width));
    margin: 0 auto;
    padding: 24px 0 48px;
    border-top: 1px solid var(--border-color);
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-links a {
    color: var(--body-text-color);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--body-text-color-hover);
  }

  .footer-waves {
    display: flex;
    overflow: hidden;
  }

  @media (max-width: 700px) {
    .footer-content {
      width: min(calc(100% - 28px), var(--max-width));
    }
  }
</style>
