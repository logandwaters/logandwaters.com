<figure class="footer-message" role="img" aria-label="Binary message decoration">
  <pre class="binary-message" is:raw><span class="message-content"><span class="message-baseline"></span><span>01001001011001100010000001111001011011110111010100100000011001100110111101110101011011100110010000100000011101000110100001101001011100110010000001111001011011110111010100100000011000010111001001100101001000000110000101110111011001010111001101101111</span>
<span>01101101011001010010000101010010011001010110110101100101011011010110001001100101011100100010000001110100011011110010000001101100011010010111011001100101001000000110011001101111011100100010000001111001011011110111010101110010011100110110010101101100</span>
<span>01100110011000010110111001100100001000000111010001101111001000000110000101101100011101110110000101111001011100110010000001110011011100000111001001100101011000010110010000100000011101000110100001100101001000000110110101100101011100110111001101100001</span>
</span></pre>
</figure>

<script>
  const messages = document.querySelectorAll<HTMLElement>(".footer-message");
  const context = document.createElement("canvas").getContext("2d");
  if (!context) throw new Error("Unable to measure binary message text.");

  const fitmessage = (message: HTMLElement) => {
    const artwork = message.querySelector<HTMLElement>(".binary-message");
    const content = message.querySelector<HTMLElement>(".message-content");
    const baseline = message.querySelector<HTMLElement>(".message-baseline");
    const width = message.getBoundingClientRect().width;
    if (!artwork || !content || !baseline || width === 0) return;

    artwork.style.fontSize = "10px";
    artwork.style.marginTop = "0";
    const contentWidth = content.getBoundingClientRect().width;
    if (contentWidth > 0) {
      artwork.style.fontSize = `${10 * width / contentWidth}px`;
      context.font = getComputedStyle(artwork).font;
      const firstLine = content.textContent?.split("\n")[0] ?? "";
      const ascent = context.measureText(firstLine).actualBoundingBoxAscent;
      const topSpace = baseline.getBoundingClientRect().top - message.getBoundingClientRect().top - ascent;
      artwork.style.marginTop = `${-topSpace}px`;
    };
  }

  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      if (entry.target instanceof HTMLElement) fitmessage(entry.target);
    }
  });

  messages.forEach((message) => observer.observe(message));
  document.fonts.ready.then(() => messages.forEach(fitmessage));
</script>

<style>
  .footer-message {
    display: flex;
    flex: 0 0 50%;
    align-items: flex-start;
    justify-content: flex-end;
    width: 50%;
    margin: 0;
    overflow: hidden;
    container-type: inline-size;
    color: var(--primary-color);
  }

  .binary-message {
    width: 100%;
    min-width: 0;
    margin: 0 0 -0.2em;
    color: inherit;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: max(1px, 0.62cqi);
    line-height: 1.2;
    white-space: pre;
  }

  .binary-message :global(.message-content) {
    display: block;
    width: max-content;
  }

  .binary-message :global(.message-baseline) {
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }

  .footer-message ~ .footer-message {
    justify-content: flex-start;
  }

  @media (max-width: 820px) {
    .footer-message:first-child {
      flex-basis: 100%;
      justify-content: center;
      width: 100%;
    }

    .footer-message ~ .footer-message {
      display: none;
    }
  }
</style>
