<button
  class="theme-switch"
  type="button"
  data-theme-switcher
  aria-label="Switch to light theme"
  aria-pressed="false"
>
  <span class="theme-switch-icons" aria-hidden="true">
    <span class="icon theme-icon theme-icon--moon"></span>
    <span class="icon theme-icon theme-icon--sun"></span>
  </span>
</button>

<style>
  .theme-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--body-text-color);
    cursor: pointer;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .theme-switch:hover {
    color: var(--body-text-color-hover);
    transform: translateY(-1px);
  }

  .theme-switch:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 4px;
  }

  .theme-switch-icons {
    position: relative;
    display: block;
    width: 20px;
    height: 20px;
  }

  .theme-icon {
    position: absolute;
    inset: 0;
    display: block;
    width: 20px;
    height: 20px;
    background-color: currentColor;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .theme-icon--moon {
    mask-image: url("/assets/icons/moon.svg");
  }

  .theme-icon--sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.65);
    mask-image: url("/assets/icons/sun.svg");
  }

  :global([data-theme="light"]) .theme-icon--moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.65);
  }

  :global([data-theme="light"]) .theme-icon--sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch,
    .theme-icon {
      transition: none;
    }
  }
</style>

<script is:inline>
  const themeSwitcher = document.querySelector("[data-theme-switcher]");

  const setTheme = (theme) => {
    if (theme === "light") {
      document.documentElement.dataset.theme = "light";
    } else {
      delete document.documentElement.dataset.theme;
    }

    themeSwitcher.setAttribute("aria-pressed", String(theme === "light"));
    themeSwitcher.setAttribute(
      "aria-label",
      theme === "light" ? "Switch to dark theme" : "Switch to light theme"
    );
    localStorage.setItem("theme", theme);
  };

  const savedTheme = localStorage.getItem("theme");
  if (savedTheme === "light" || savedTheme === "dark") {
    setTheme(savedTheme);
  }

  themeSwitcher.addEventListener("click", () => {
    const nextTheme =
      document.documentElement.dataset.theme === "light" ? "dark" : "light";
    setTheme(nextTheme);
  });
</script>
