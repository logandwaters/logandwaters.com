---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import Navigation from "./Navigation.astro";
import EmailLink from "./EmailLink.astro";
---

<header class="site-header">
  <a href="/" aria-label="Home">
    <span class="header-logo header-logo--ldw" aria-hidden="true"></span>
  </a>

  <div class="header-right">
    <Navigation />

    <div class="icon-links" aria-label="Social links" title="Switch theme">
      <ThemeSwitcher />
    </div>

    <div class="icon-links" aria-label="Social links">
      <a href="https://github.com/logandwaters" aria-label="GitHub" title="Visit my GitHub">
        <span class="social-icon social-icon--github" aria-hidden="true"></span>
      </a>

      <EmailLink user="hello" domain="logandwaters.com" aria-label="Email" title="Send me an email">
        <span class="social-icon social-icon--email" aria-hidden="true"></span>
      </EmailLink>
    </div>
  </div>
</header>

<style>
  /* Brand mark */
  .header-logo {
    display: block;
    height: 18px;
    width: 48.5px;
    background-color: var(--primary-color);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  /* Header layout */
  .header-logo--ldw {
    mask-image: url("/assets/brand/ldw-logo.svg");
  }

  .site-header {
    position: relative;
    z-index: 1;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
    width: min(125%, calc(100vw - var(--space-site-gutter)));
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--border-color);
    transform: translateX(-50%);
  }

  /* Header actions */
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .icon-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-left: var(--space-lg);
    border-left: 1px solid var(--border-color);
  }

  .icon-links :global(a) {
    display: flex;
    color: var(--body-text-color);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .icon-links :global(a):hover {
    color: var(--body-text-color-hover);
    transform: translateY(var(--hover-lift));
  }

  /* Social icons */
  .social-icon {
    display: block;
    width: var(--size-icon);
    height: var(--size-icon);
    background-color: currentColor;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  .social-icon--github {
    mask-image: url("/assets/icons/github.svg");
  }

  .social-icon--email {
    mask-image: url("/assets/icons/paper-plane.svg");
  }

  /* Narrow header spacing */
  @media (max-width: 430px) {
    .site-header {
      gap: var(--space-lg);
    }
  }
</style>
