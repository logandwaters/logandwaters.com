---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import Navigation from "./Navigation.astro";
---

<header class="site-header">
  <a href="/" aria-label="Home">
    <span class="header-logo header-logo--ldw" aria-hidden="true"></span>
  </a>

  <div class="header-right">
    <Navigation />

    <div class="icon-links" aria-label="Social links">
      <ThemeSwitcher />
    </div>

    <div class="icon-links" aria-label="Social links">
      <a href="https://github.com/logandwaters" aria-label="GitHub" title="Visit my GitHub">
        <span class="social-icon social-icon--github" aria-hidden="true"></span>
      </a>

      <a href="mailto:me@logandwaters.com" aria-label="Email" title="Send me an email">
        <span class="social-icon social-icon--email" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>

<style>

  .header-logo {
    display: block;
    height: 18px;
    width: 48.5px;
    background-color: var(--primary-color);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  .header-logo--ldw {
    mask-image: url("/assets/brand/ldw-logo.svg");
  }

  .site-header {
    position: relative;
    z-index: 1;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: min(125%, calc(100vw - 40px));
    padding: 26px 0;
    border-bottom: 1px solid var(--border-color);
    transform: translateX(-50%);
  }

  .site-name {
    color: var(--title-text-color);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .icon-links {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-left: 20px;
    border-left: 1px solid var(--border-color);
  }

  .icon-links a {
    display: flex;
    color: var(--body-text-color);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .icon-links a:hover {
    color: var(--body-text-color-hover);
    transform: translateY(-1px);
  }

  .social-icon {
    display: block;
    width: 20px;
    height: 20px;
    background-color: currentColor;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  .social-icon--github {
    mask-image: url("/assets/icons/github-logo.svg");
  }

  .social-icon--email {
    mask-image: url("/assets/icons/paper-plane-tilt.svg");
  }

  @media (max-width: 430px) {
    .site-header {
      gap: 15px;
    }
  }
</style>
