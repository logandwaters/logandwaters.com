---
import "../styles/global.css";
import "../styles/pages.css";
import Silhouette from "../components/text-art/Silhouette.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import EmailLink from "../components/site/EmailLink.astro";
import Line from "../components/text-art/BinaryLine.astro"
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="The personal website of Logan Waters.">

  <title>Home | Logan Waters</title>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <script>
    const trigger = document.getElementById("encryption-trigger");
    const continuation = document.getElementById("encryption-continuation");

    if (!trigger || !continuation) {
      throw new Error("Encryption disclosure elements not found.");
    }

    trigger.addEventListener("click", () => {
      continuation.hidden = !continuation.hidden;
      trigger.setAttribute("aria-expanded", String(!continuation.hidden));
    });
  </script>
</head>

<body>
  <main class="site">

    <Header />

    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <Silhouette />
        <div class="intro-text">
          <p class="eyebrow">Hello.</p>
          <h1 id="intro-title">I'm Logan.</h1>
          <p class="lead">
            Coming from a business background, I’m working my way into web development & design. I learn by doing, figure things out through experience, and enjoy getting into the technical details.
          </p>
          <p class="lead">
            I like building simple, user-focused tools & systems, with a focus on high-performance, static-first architectures for web apps & sites.
            Outside of that, I’m constantly digging deeper into infrastructure and exploring whatever else catches my interest.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="currently" aria-labelledby="currently-title">
      <div class="section-heading">
        <p class="eyebrow">1.0</p>
        <h2 id="currently-title">Currently</h2>
      </div>

      <div class="list">
        <div>
          <h3>Learning</h3>
          <p>
            Deepening my understanding of the core web stack, with a focus on building fast, responsive,
            accessible, static-first websites using HTML, CSS, JavaScript, and <a class="link" href="https://astro.build/">Astro.</a>
          </p>
        </div>

        <div>
          <h3>Building</h3>
          <p>
            Building <a class="link" href="https://toolgek.com/">Toolgek</a>, a static platform of simple, fast, browser-based developer utilities.
            It's built with Astro and powered by a collection of internally developed open-source JavaScript tool packages.
          </p>
        </div>

        <div>
          <h3>Exploring</h3>
          <p>
            Exploring freelance website design for small and medium-sized businesses, with a focus on professional, static brochure websites built as first class business assets.
          </p>
        </div>

        <div>
          <h3>Tinkering</h3>
          <p>
            Tinkering with everything. Self-hosted Linux servers, Windows desktops, SBCs and computer hardware.
            Working with networks, containerization, automation, open-source software, and LLMs.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="eyebrow">2.0</p>
        <h2 id="projects-title">Things I'm building</h2>
      </div>
    
      <div class="project-list">
    
        <details class="project">
          <summary>
            <div class="project-summary">
              <h3>Toolgek</h3>
              <p>An open-source collection of browser-based developer tools built around self-describing packages.</p>
            </div>
            <span class="arrow" aria-hidden="true"></span>
          </summary>
    
          <div class="project-details">
            <p>
              A growing collection of simple, client-side developer tools for
              tasks like text transformation, encoding, and validation. Each
              tool is defined as a self-contained package, with its own
              manifest, interface, and content.
            </p>
            <a class="link" href="https://toolgek.com" title="Visit toolgek.com" target="_blank" rel="noopener">toolgek.com</a>
            {" "}<span aria-hidden="true">·</span>{" "}
            <a class="link" href="https://github.com/toolgek" title="Visit Toolgek on Github" target="_blank" rel="noopener">Toolgek on Github</a>
          </div>
        </details>

        <Line />
    
        <details class="project">
          <summary>
            <div class="project-summary">
              <h3>Infrastructure</h3>
              <p>Self-hosted infrastructure, networking, security, and deployment automation.</p>
            </div>
            <span class="arrow" aria-hidden="true"></span>
          </summary>
    
          <div class="project-details">
            <p>
              I manage the infrastructure behind my own projects, covering
              domains, DNS, networking, server security, hosting, maintenance,
              and deployment automation. This site and Toolgek are both
              self-hosted and maintained by me, with infrastructure for
              additional projects in development.
            </p>
          </div>
        </details>

        <Line />
    
        <details class="project">
          <summary>
            <div class="project-summary">
              <h3>Metaline Graphics</h3>
              <p>Website redesign, development, and hosting for an established Canadian manufacturer.</p>
            </div>
            <span class="arrow" aria-hidden="true"></span>
          </summary>
    
          <div class="project-details">
            <p>
              A complete website redesign for Metaline Graphics Ltd., a
              family-owned manufacturer established in 1974. My work covers
              the site's design, content, and development, along with the
              hosting and infrastructure needed to keep it running.
            </p>
            <a class="link" href="https://metalinegraphics.ca" title="Visit Metaline Graphics" target="_blank" rel="noopener">metalinegraphics.ca</a>
          </div>
        </details>
    
      </div>
    </section>

    <section class="section" id="about-me" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="eyebrow">3.0</p>
        <h2 id="experience-title">How I got here</h2>
      </div>

      <p class="body-copy">
        I've always enjoyed building things and exploring creative projects.
        My introduction to web development came in 2018, when I built my first website for a high-school project simply because I wanted to approach it differently. 
        Later that year, I rebuilt my dad's small business website, mostly just to see if I could. It was a simple project, but it sparked an interest that stuck.
      </p>

      <div style="margin: 22px 0;">
        <Line />
      </div>

      <p class="body-copy">
        Over the following years, I built websites for school projects, small businesses, friends, and personal projects.
        Most of my early work used visual website builders, giving me room to experiment with layouts and design.
        With each project, I became more interested in what I could create and how I could improve it.
        Eventually, that curiosity grew into an interest in building more capable websites and understanding how they worked behind the scenes.
      </p>

      <p class="body-copy">
        While pursuing a business degree at university, I started experimenting with server software and building my own homelab.
        This became a major turning point for me. Self-hosting services and learning to manage my own infrastructure opened up a much deeper side of technology,
        sparking an interest in programming and understanding the systems behind the software I used.
      </p>

      <div style="margin: 22px 0;">
        <Line />
      </div>

      <p class="body-copy">
        Over the last couple of years, I've focused on teaching myself programming and the core web technologies through personal projects, experimentation,
        and plenty of trial and error. Alongside that, I've been developing my eye for design, particularly the intersection of technical aesthetics and thoughtful visual design.
        Looking ahead, I hope to contribute more to the open-source community and take on freelance web design and development projects.
      </p>
    </section>

    <section class="section" id="tech-stack" aria-labelledby="stack-title">
      <div class="section-heading">
        <p class="eyebrow">4.0</p>
        <h2 id="stack-title">What I'm using</h2>
      </div>

      <p class="body-copy">
        I work across multiple layers of the web, from building interfaces and web applications to managing the infrastructure they run on. My toolkit is always evolving as I build, experiment, and take on more technical challenges.
      </p>

      <div class="badge-groups">
        <h3>Technologies</h3>

        <div class="badge-group">
          <h3>Languages & Frameworks</h3>
          <div class="badges">
            <img src="/badges/HTML5.svg" alt="HTML5">
            <img src="/badges/JavaScript.svg" alt="JavaScript">
            <img src="/badges/CSS.svg" alt="CSS">
            <img src="/badges/Astro.svg" alt="Astro">
          </div>
        </div>

        <div class="badge-group">
          <h3>Infrastructure</h3>
          <div class="badges">
            <img src="/badges/Docker.svg" alt="Docker">
            <img src="/badges/Linux.svg" alt="Linux">
            <img src="/badges/Cloudflare.svg" alt="Cloudflare">
            <img src="/badges/Nginx.svg" alt="Nginx">
          </div>
        </div>

        <div class="badge-group">
          <h3>Development Tools</h3>
          <div class="badges">
            <img src="/badges/Node.svg" alt="Node.js">
            <img src="/badges/Git.svg" alt="Git">
            <img src="/badges/GitHub.svg" alt="GitHub">
          </div>
        </div>

      </div>

    </section>

    <section class="section" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="eyebrow">5.0</p>
        <h2 id="contact-title">Contact</h2>
      </div>

      <div class="list">
        <p class="body-copy">
          Have a question, want to discuss a project, or just get in touch? You can reach me by email or find me on GitHub.
        </p>

        <div>
          <h3>Email</h3>
          <p>The best way to reach me is by email at <EmailLink class="interact" user="hello" domain="logandwaters.com" />.</p>
          <p class="meta-text">
            <button id="encryption-trigger" class="trigger" type="button" aria-expanded="false" aria-controls="encryption-continuation">Prefer encrypted communication?</button>
            <span id="encryption-continuation" hidden> You can use my OpenPGP public key to send me an end-to-end encrypted email. <a
              class="link"
              style="text-decoration: none;"
              href="/pgp-keys/logandwaters-b13152902a3c0c3a2fafd8e355798c3849fa7f0c.asc"
              title="Download my OpenPGP public key"
              download
            >[ Download OpenPGP Public Key ]</a></span>
          </p>
        </div>

        <div>
          <h3>GitHub</h3>
          <p>
            Explore what I'm working on, browse my repositories, or join a discussion on <a
            class="link"
            href="https://github.com/logandwaters" 
            target="_blank" 
            rel="noopener noreferrer"
          >GitHub</a>.
          </p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</body>
</html>