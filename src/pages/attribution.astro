---
import "../styles/global.css";
import "../styles/pages.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import Line from "../components/text-art/BinaryLine.astro"

const title = "Attribution | Logan Waters";
const description = "Credits for the open-source tools, artwork, icons, and fonts used on Logan Waters' website.";
const siteUrl = Astro.site;

if (!siteUrl) {
  throw new Error("Astro site URL must be configured for canonical metadata.");
}

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL("/android-chrome-512x512.png", siteUrl).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>

  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Logan Waters">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:image:alt" content="Logan Waters monogram">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImageUrl}>
  <meta name="twitter:image:alt" content="Logan Waters monogram">

  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/manifest.webmanifest">
</head>

<body>
  <main class="site">

    <Header />

    <section class="section" style="border: none;">
      <div class="section-heading-alt">
        <h1>Attribution</h1>
        <p>My work is made possible by the many creators and open-source communities whose work helps power the open web.</p>
        <Line />
      </div>

      <div class="list attribution-list">
        <div>
          <h2>Framework</h2>
          <p>This site was built with <a class="link" href="https://astro.build/" title="Visit site" target="_blank" rel="noopener">Astro</a>, an open-source web framework.
            It uses Astro’s build-time static rendering to generate fast, lightweight pages.
          </p>
        </div>

        <div>
          <h2>Assets</h2>

          <div class="list-item">
            <p>ASCII Artwork:</p>
            <a class="link" href="https://jasperbernaers.com/image-to-ascii/" title="Visit site" target="_blank" rel="noopener"
            >Jasper Bernaers' Image to ASCII Tool</a>
          </div>

          <div class="list-item">
            <p>Tech Stack Badges:</p>
            <a class="link" href="https://shields.io/" title="Visit site" target="_blank" rel="noopener"
            >Shields.io</a>
          </div>

          <div class="list-item">
            <p>Site Icons:</p>
            <a class="link" href="https://phosphoricons.com/" title="Visit site" target="_blank" rel="noopener"
            >Phosphor Icons</a>
          </div>
        </div>

        <div>
          <h2>Fonts</h2>

          <div class="list-item">
            <p>Titles are written in the <a class="link" style="font-family: var(--font-family-title);" href="https://www.ibm.com/plex/" title="Visit site" target="_blank" rel="noopener"
              >IBM Plex&reg;
              </a> typeface.
            </p>
          </div>

          <div class="list-item">
            <p>Body copy is written in the <a class="link" style="font-family: var(--font-family-body);" href="https://www.theleagueofmoveabletype.com/raleway" title="Visit site" target="_blank" rel="noopener"
              >Raleway
              </a> typeface.
            </p>
          </div>

          <div class="list-item">
            <p>Meta text is written in the <a class="link" style="font-family: var(--font-family-meta);" href="https://www.jetbrains.com/lp/mono/" title="Visit site" target="_blank" rel="noopener"
              >JetBrains Mono
              </a> typeface.
            </p>
          </div>
        </div>

        <div>
          <h2>License</h2>
          <p>The source code for this website is publicly available for viewing and educational reference.
            No license is granted for copying, modifying, redistributing, or using the source code or website design as a separate project.
          </p>
          <p><strong>© 2026 Logan Waters. All rights reserved.</strong></p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</body>
</html>