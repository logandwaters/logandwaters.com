---
import "../style.css";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="The personal website of Logan Waters.">
  <title>Logan Waters</title>
</head>

<body>
  <main class="site">

    <header class="site-header">
      <img class="header-logo" src="/assets/brand/ldw-logo.svg" alt="">

      <div class="header-right">
        <nav aria-label="Main navigation">
          <a href="#projects">Projects</a>
          <a href="#notes">Notes</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="social-links" aria-label="Social links">
          <a href="https://github.com/logandwaters" aria-label="GitHub" title="Visit my GitHub">
            <img class="icon" src="/assets/icons/github-logo.svg" alt="">
          </a>

          <a href="mailto:me@logandwaters.com" aria-label="Email" title="Send me an email">
            <img class="icon" src="/assets/icons/paper-plane-tilt.svg" alt="">
          </a>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="experience-title">
      <div class="section-heading">
        <span class="section-number">?</span>
        <h2 id="experience-title">Privacy</h2>
      </div>

      <p class="body-copy">
        For additional privacy:
        Use our OpenPGP public key to send an
        end-to-end encrypted email.
      </p>

      <a href="/pgp/logandwaters-public-key.asc" download>[ Download Public Key ]</a>

      <p class="body-copy">
        PGP fingerprint: XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX
      </p>
    </section>

    <!-- Social Section -->

  </main>
  <footer class="site-footer">
    <iframe class="footer-wave" src="/assets/art/wave-ascii-art.html" title="ASCII art wave"></iframe><iframe class="footer-wave" src="/assets/art/wave-ascii-art.html" title="ASCII art wave"></iframe>
  </footer>
</body>
</html>